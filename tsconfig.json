{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "erasableSyntaxOnly": true,
    "declaration": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "newLine": "lf"
  },
  "include": [
    "src"
  ]
}
